rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función helper para verificar si es admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email != null;
    }
    
    // Courts collection
    match /courts/{courtId} {
      // Cualquiera puede leer (para ver lista de canchas)
      allow read: if true;
      
      // Solo admins pueden crear, actualizar o eliminar
      allow create, update, delete: if isAdmin();
    }
    
    // Subscriptions collection
    match /subscriptions/{subscriptionId} {
      // Cualquiera puede leer sus propias suscripciones
      allow read: if true;
      
      // Cualquiera puede crear suscripciones
      allow create: if request.resource.data.keys().hasAll(['courtId', 'courtNumber', 'token', 'subscribedAt']);
      
      // Solo se pueden eliminar las propias suscripciones
      allow delete: if true;
      
      // Solo admins pueden actualizar
      allow update: if isAdmin();
    }
    
    // Notifications collection - Cada usuario puede acceder a sus propias notificaciones
    match /notifications/{token} {
      // Cualquiera puede leer/escribir en su propia colección de notificaciones
      allow read, write: if true;

      // Subcollection de mensajes
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
    
    // Statistics collection (opcional)
    match /statistics/{statId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}